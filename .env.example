# Copia este archivo como .env y llena los valores reales (.env no se sube a git).

# Supabase → Connect → Session pooler (puerto 5432, compatible con IPv4)
DATABASE_URL=postgresql://postgres.<proyecto>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# SSL en false solo si se usa un Postgres local sin SSL.
DB_SSL=true

# NUNCA true contra Supabase: TypeORM alteraría/borraría columnas y enums.
DB_SYNC=false

# Conexiones máximas hacia el pooler.
DB_POOL_MAX=5

# Secreto para firmar los JWT (cadena larga y aleatoria).
JWT_SECRET=

# Opcional: dominio(s) del frontend separados por coma.
CORS_ORIGIN=

PORT=3000
